---
import img1 from "/public/imgs/Tema 9.png";
import img2 from "../assets/uge44-2025.webp";
import img3 from "../assets/de_doedes_dag.webp";
import img4 from "../assets/naar_doeden_os_skiller.webp";

---
<section>
<div class="smallcard">
    <div class="grid-1-1"><div class="single-card">
              <img src={img1.src} alt="UGE 44 2026" />

      <h3>UGE 44 i 2026</h3>

      <p>
        2024 bar præg af, at flere sluttede sig til vores kampagne. Vi gjorde derfor danskere opmærksomme.
      </p>

      <a href="#" class="btn primary">Læs mere</a>
    </div>  <div class="single-card">
              <img src={img2.src} alt="UGE 44 2026" />

      <h3>UGE 44 i 2026</h3>

      <p>
        2024 bar præg af, at flere sluttede sig til vores kampagne. Vi gjorde derfor danskere opmærksomme.
      </p>

      <a href="#" class="btn primary">Læs mere</a>
      </div>
    </div>


    <div class="grid-1-1"><div class="single-card">
              <img src={img3.src} alt="UGE 44 2026" />

      <h3>UGE 44 i 2026</h3>

      <p>
        2024 bar præg af, at flere sluttede sig til vores kampagne. Vi gjorde derfor danskere opmærksomme.
      </p>

      <a href="#" class="btn primary">Læs mere</a>
    </div>  <div class="single-card">
              <img src={img4.src} alt="UGE 44 2026" />

      <h3>UGE 44 i 2026</h3>

      <p>
        2024 bar præg af, at flere sluttede sig til vores kampagne. Vi gjorde derfor danskere opmærksomme.
      </p>

      <a href="#" class="btn primary">Læs mere</a>
      </div>
   </div>
</div>

<style>
    body {
    background-color: #F5F3EF;
}
.grid-1-1 {
    
    display: grid;
    grid-template-columns: 1fr 1fr;
     
width: 100%;
    
    background: white;
    border-radius: 16px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
}

.smallcard {
    margin: 0 auto;
    width: 90%;
    background: #f4f4f4;
    margin: 2rem;
    padding: 2rem;
}


img {
    padding: 2em;
    width: 100%;
}

.grid-1-1 h3 {
font-family: 'Raleway', sans-serif;
 font-size: 16px;
 margin-left: 10%;
  padding: 1em;
}

.grid-1-1 p {
  font-size: 16px;
 margin-left: 10%;
  line-height: 1.5;
  padding: 1em;
}

.grid-1-1 a {
  font-size: 12px;
  margin-bottom: 20px;
  padding: 1em;
   background: transparent;
  border: 2px solid #000;
  color: #000;
  border-radius: 999px;
  margin-left: 15%;
}
</style>