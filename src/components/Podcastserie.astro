---
import podcastImg from "../assets/Podcast.webp"; // skift til dit billede
---

<section class="podcast">
  
  <!-- Venstre: billede -->
  <div class="podcast-image">
    <img src={podcastImg.src} alt="Podcastserie" />
  </div>

  <!-- Højre: tekst -->
  <div class="podcast-content">
    <h3>Podcastserie: Når døden os skiller</h3>

    <p>
      Her kan du lytte til vores nye podcastserie, der vil forsøge at gøre den svære samtale om døden lettere
    </p>

    <div class="podcast-buttons">
      <a href="#" class="btn primary">Tilmeld</a>
      <a href="#" class="btn outline">Del event</a>
    </div>
  </div>

</section>

<style>
.podcast {
  grid-column: 1 / -1;

  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 60px;

  max-width: 1100px;
  margin: 0 auto;
  padding: 80px 20px;

  align-items: center;
}

/* billede */
.podcast-image img {
  width: 100%;
  border-radius: 12px;
}

/* tekst */
.podcast-content h3 {
  font-size: 24px;
  margin-bottom: 10px;
}

.podcast-content p {
  font-size: 16px;
  line-height: 1.5;
  margin-bottom: 25px;
}

/* knapper */
.podcast-buttons {
  display: flex;
  gap: 15px;
}

/* outline button */
.btn.outline {
  background: transparent;
  border: 2px solid #c07a6b;
  color: #c07a6b;
}

/* responsive */
@media (max-width: 768px) {
  .podcast {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .podcast-buttons {
    justify-content: center;
  }
}
</style>