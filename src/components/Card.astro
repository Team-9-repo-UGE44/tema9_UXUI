---

const {src, title, href} = Astro.props;

---

<div>
    <img src={src} alt={title} />
    <h3>{title}</h3>
    <slot />
    <a href={href} class="btn primary"><strong>Læs mere</strong></a>
</div>

<style>


h3 {
font-family: 'Raleway', sans-serif;
 font-size: 16px;
 margin-left: 10%;
  padding: 1em;
}

p {
  font-size: 16px;
 margin-left: 10%;
  line-height: 1.5;
  padding: 1em;
}

a {
  font-size: 12px;
  margin-bottom: 20px;
  padding: 1em;
   background: transparent;
  border: 2px solid #000;
  color: #000;
  border-radius: 999px;
  margin-left: 15%;
  display: inline-block;
}

    img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
    max-height: 460px;
    margin-bottom: 2rem;
}



