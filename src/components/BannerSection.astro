---
import cardImg from "../assets/event-kalender-oversigt-uge-44.webp"; // billede
---

<section class="info-section">
  
  <!-- Venstre (kort) -->
  <div class="info-left">
    <img src={cardImg.src} alt="Event kalender" />
  </div>

  <!-- Højre (tekst) -->
  <div class="info-right">
    <p>
      I vores kalender finder du informationer om vores aktuelle udstillinger og arrangementer. 
      Under det enkelte arrangement kan du også tilmelde dig.
    </p>
  </div>

</section>

<style>
.info-section {
  grid-column: 1 / -1;

  display: grid;
  grid-template-columns: 250px 1fr;
  gap: 60px;

  max-width: 1100px;
  margin: 0 auto;
  padding: 80px 20px;

  align-items: center;
}

.info-left img {
  width: 100%;
  border-radius: 12px;
}

.info-right p {
  font-size: 18px;
  line-height: 1.6;
}
</style>